/// Schema & Column Shape
/// Asserts that a table has all the specified columns (comma-separated list).
function 'PQL.Assert.Tbl.ShouldHaveColumns' =
		(testName : STRING, tableRef : STRING, columnNamesList : STRING) =>
			VAR _Columns = INFO.VIEW.COLUMNS()
			VAR _TableColumns = FILTER(_Columns, [Table] = tableRef)
			VAR _ExpectedCount = LEN(columnNamesList) - LEN(SUBSTITUTE(columnNamesList, ",", "")) + 1
			VAR _ColumnNamesUpper = UPPER(columnNamesList)
			VAR _MatchedColumns = FILTER(
				_TableColumns,
				CONTAINSSTRING("," & _ColumnNamesUpper & ",", "," & TRIM(UPPER([Name])) & ",")
			)
			VAR _MatchedCount = COUNTROWS(_MatchedColumns)
			VAR _MissingCount = _ExpectedCount - _MatchedCount
			VAR _ActualColumnNames = CONCATENATEX(_TableColumns, [Name], ", ", [Name], ASC)
			VAR _Passed = _MissingCount <= 0
			RETURN ROW(
				"TestName", testName,
				"Expected", "Table '" & tableRef & "' has columns: " & columnNamesList,
				"Actual", IF(_Passed, "ALL COLUMNS FOUND", "MISSING " & FORMAT(_MissingCount, "0") & " COLUMN(S). Available: " & _ActualColumnNames),
				"Passed", _Passed
			)
	lineageTag: b8e9b4ee-7b57-471f-80d3-b5935a4599dd

	annotation DAXLIB_PackageId = PQL.Assert

	annotation DAXLIB_PackageVersion = 0.6.2

/// Asserts that a table does not have extra columns beyond the allowed list (comma-separated).
function 'PQL.Assert.Tbl.ShouldNotHaveExtraColumns' =
		(testName : STRING, tableRef : STRING, allowedColumnNamesList : STRING) =>
			VAR _Columns = INFO.VIEW.COLUMNS()
			VAR _TableColumns = FILTER(_Columns, [Table] = tableRef && [Type] <> "RowNumber")
			VAR _TableColumnCount = COUNTROWS(_TableColumns)
			VAR _AllowedUpper = UPPER(allowedColumnNamesList)
			VAR _ExtraColumns = FILTER(
				_TableColumns,
				NOT CONTAINSSTRING("," & _AllowedUpper & ",", "," & TRIM(UPPER([Name])) & ",")
			)
			VAR _ExtraCount = COUNTROWS(_ExtraColumns)
			VAR _ExtraList = CONCATENATEX(_ExtraColumns, [Name], ", ", [Name], ASC)
			VAR _Passed = _ExtraCount = 0
			RETURN ROW(
				"TestName", testName,
				"Expected", "No extra columns beyond: " & allowedColumnNamesList,
				"Actual", IF(_Passed, "NO EXTRA COLUMNS (" & FORMAT(_TableColumnCount, "0") & " columns)", "EXTRA COLUMNS FOUND (" & FORMAT(_ExtraCount, "0") & "): " & _ExtraList),
				"Passed", _Passed
			)
	lineageTag: d2ef9720-c62e-4944-934b-9561cf6d9dd5

	annotation DAXLIB_PackageId = PQL.Assert

	annotation DAXLIB_PackageVersion = 0.6.2

/// Asserts that a column in a table has the expected data type.
function 'PQL.Assert.Tbl.ColumnDataTypeShouldBe' =
		(testName : STRING, tableRef : STRING, columnName : STRING, expectedType : STRING) =>
			VAR _Columns = INFO.VIEW.COLUMNS()
			VAR _MatchingColumn = FILTER(_Columns, [Table] = tableRef && [Name] = columnName)
			VAR _Found = COUNTROWS(_MatchingColumn) > 0
			VAR _ActualType = IF(_Found, MAXX(_MatchingColumn, [DataType]), "COLUMN NOT FOUND")
			VAR _Passed = _Found && UPPER(_ActualType) = UPPER(expectedType)
			RETURN ROW(
				"TestName", testName,
				"Expected", "Column '" & tableRef & "[" & columnName & "]' data type = " & expectedType,
				"Actual", IF(_Found, "DataType = " & _ActualType, "COLUMN NOT FOUND"),
				"Passed", _Passed
			)
	lineageTag: 56403ce7-ed33-404d-a8b9-56b4e225929b

	annotation DAXLIB_PackageId = PQL.Assert

	annotation DAXLIB_PackageVersion = 0.6.2

/// Retrieves all test functions with full metadata (Description, RLS ImpersonatedUserName, RoleName).
/// Uses INFO.USERDEFINEDFUNCTIONS and INFO.ANNOTATIONS - NOT compatible with Power Automate REST API.
/// Use RetrieveTests for Power Automate compatibility.
function 'PQL.Assert.RetrieveTestsV2' =
		() =>
		    VAR _BaseFunctions =
		        SELECTCOLUMNS(
		            FILTER(
		                INFO.FUNCTIONS("ORIGIN", "2"),
		                OR(RIGHT([FUNCTION_NAME], 5) = ".Test", RIGHT([FUNCTION_NAME], 6) = ".Tests")
		            ),
		            "Name", [FUNCTION_NAME]
		        )
		    RETURN
		        ADDCOLUMNS(
		            _BaseFunctions,
		            "Description",
		            VAR _funcName = [Name]
		            RETURN
		            IFERROR(
		                MAXX(FILTER(INFO.USERDEFINEDFUNCTIONS(), [Name] = _funcName), [Description]),
		                BLANK()
		            ),
		            "PQLAssert_ImpersonatedUserName",
		            VAR _funcName = [Name]
		            VAR _funcID =
		                IFERROR(
		                    MAXX(FILTER(INFO.USERDEFINEDFUNCTIONS(), [Name] = _funcName), [ID]),
		                    BLANK()
		                )
		            RETURN
		            IFERROR(
		                MAXX(
		                    FILTER(
		                        INFO.ANNOTATIONS(),
		                        [Name] = "PQLAssert_ImpersonatedUserName"
		                            && [ObjectID] = _funcID
		                    ),
		                    [Value]
		                ),
		                BLANK()
		            ),
		            "PQLAssert_RoleName",
		            VAR _funcName = [Name]
		            VAR _funcID =
		                IFERROR(
		                    MAXX(FILTER(INFO.USERDEFINEDFUNCTIONS(), [Name] = _funcName), [ID]),
		                    BLANK()
		                )
		            RETURN
		            IFERROR(
		                MAXX(
		                    FILTER(
		                        INFO.ANNOTATIONS(),
		                        [Name] = "PQLAssert_RoleName"
		                            && [ObjectID] = _funcID
		                    ),
		                    [Value]
		                ),
		                BLANK()
		            )
		        )
	lineageTag: 61b6224a-c1ec-4da7-8990-af21c73b64ff

	annotation DAXLIB_PackageId = PQL.Assert

	annotation DAXLIB_PackageVersion = 0.6.2

/// Retrieves tests filtered by environment with full metadata (Description, RLS ImpersonatedUserName, RoleName).
/// Looks for .{ENV}. or .ANY. in function names. If environment is blank, returns all tests.
/// Uses INFO.USERDEFINEDFUNCTIONS and INFO.ANNOTATIONS - NOT compatible with Power Automate REST API.
/// Use RetrieveTestsByEnvironment for Power Automate compatibility.
/// @param {STRING} [environment] - Optional environment filter (DEV, TEST, PROD, etc.). Default is "" (all tests).
function 'PQL.Assert.RetrieveTestsByEnvironmentV2' =
		(environment: STRING = "") =>
		    VAR _EnvUpper = UPPER(environment)
		    VAR _BaseFunctions =
		        SELECTCOLUMNS(
		            FILTER(
		                INFO.FUNCTIONS("ORIGIN", "2"),
		                (RIGHT([FUNCTION_NAME], 5) = ".Test" || RIGHT([FUNCTION_NAME], 6) = ".Tests")
		                && (
		                    ISBLANK(_EnvUpper) || _EnvUpper = ""
		                    || CONTAINSSTRING(UPPER([FUNCTION_NAME]), "." & _EnvUpper & ".")
		                    || CONTAINSSTRING(UPPER([FUNCTION_NAME]), ".ANY.")
		                )
		            ),
		            "Name", [FUNCTION_NAME]
		        )
		    RETURN
		        ADDCOLUMNS(
		            _BaseFunctions,
		            "Description",
		            VAR _funcName = [Name]
		            RETURN
		            IFERROR(
		                MAXX(FILTER(INFO.USERDEFINEDFUNCTIONS(), [Name] = _funcName), [Description]),
		                BLANK()
		            ),
		            "PQLAssert_ImpersonatedUserName",
		            VAR _funcName = [Name]
		            VAR _funcID =
		                IFERROR(
		                    MAXX(FILTER(INFO.USERDEFINEDFUNCTIONS(), [Name] = _funcName), [ID]),
		                    BLANK()
		                )
		            RETURN
		            IFERROR(
		                MAXX(
		                    FILTER(
		                        INFO.ANNOTATIONS(),
		                        [Name] = "PQLAssert_ImpersonatedUserName"
		                            && [ObjectID] = _funcID
		                    ),
		                    [Value]
		                ),
		                BLANK()
		            ),
		            "PQLAssert_RoleName",
		            VAR _funcName = [Name]
		            VAR _funcID =
		                IFERROR(
		                    MAXX(FILTER(INFO.USERDEFINEDFUNCTIONS(), [Name] = _funcName), [ID]),
		                    BLANK()
		                )
		            RETURN
		            IFERROR(
		                MAXX(
		                    FILTER(
		                        INFO.ANNOTATIONS(),
		                        [Name] = "PQLAssert_RoleName"
		                            && [ObjectID] = _funcID
		                    ),
		                    [Value]
		                ),
		                BLANK()
		            )
		        )
	lineageTag: 8e63f475-f387-4d62-8ffa-b566b6b2edb5

	annotation DAXLIB_PackageId = PQL.Assert

	annotation DAXLIB_PackageVersion = 0.6.2

/// Asserts whether column is available for MDX queries. Prevents problems for downstream Analyze in Excel users
function 'PQL.Assert.Col.IsAvailableInMDX' =
		(testName : STRING, tableName : STRING, columnName : STRING) =>
			VAR _ColumnID = MAXX(FILTER(INFO.VIEW.COLUMNS(), [Table] = tableName && [Name] = columnName), [ID])
			VAR _ColumnExists = NOT ISBLANK(_ColumnID)
			VAR _IsMDXActive = COUNTROWS(FILTER(INFO.COLUMNS(), [ID] = _ColumnID && [IsAvailableInMDX] = TRUE())) = 1
			RETURN ROW(
				"TestName", testName,
				"Expected", "Column '" & tableName & "'[" & columnName & "] should be available in MDX",
				"Actual", SWITCH(TRUE(), NOT _ColumnExists, "Column not found", _IsMDXActive, "Available in MDX", "Not available in MDX"),
				"Passed", _ColumnExists && _IsMDXActive,
				"IsMDXActive", _IsMDXActive
			)
	lineageTag: ea012d4b-d9b4-4a22-908f-02211d63985b

